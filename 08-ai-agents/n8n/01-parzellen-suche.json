{
  "name": "01 - Parzellen-Suche Kanton Bern",
  "nodes": [
    {
      "parameters": {},
      "id": "n1-manual-trigger",
      "name": "Manueller Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [100, 340]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "c1", "name": "gemeinde",    "value": "Köniz",      "type": "string" },
            { "id": "c2", "name": "min_sqm",     "value": 900,          "type": "number" },
            { "id": "c3", "name": "max_sqm",     "value": 2000,         "type": "number" },
            { "id": "c4", "name": "chat_id",     "value": "5547810016", "type": "string" },
            { "id": "c5", "name": "max_baujahr", "value": 1985,         "type": "number" }
          ]
        },
        "options": {}
      },
      "id": "n2-config",
      "name": "Konfiguration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [300, 340]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Overpass-Query für EFH-Gebäude in der Gemeinde aufbauen\nconst gemeinde = $json.gemeinde;\nconst query = `[out:json][timeout:60];\narea[\"name\"=\"${gemeinde}\"][\"boundary\"=\"administrative\"]->.city;\n(\n  way[\"building\"~\"^(house|detached|bungalow)$\"](area.city);\n  way[\"building\"=\"residential\"][\"building:levels\"~\"^[12]$\"](area.city);\n);\nout center tags;`;\nreturn [{ json: { ...$json, overpass_query: query } }];"
      },
      "id": "n2b-build-query",
      "name": "Overpass-Query aufbauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 340]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://overpass-api.de/api/interpreter",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "data", "value": "={{ $json.overpass_query }}" }
          ]
        },
        "options": {}
      },
      "id": "n3-osm-search",
      "name": "Gebäude-Suche (Overpass)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 340]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Overpass-Ergebnis parsen – WGS84 direkt, keine Koordinaten-Umrechnung nötig\nconst config = $('Konfiguration').first().json;\nconst elements = $input.first().json.elements || [];\n\nif (elements.length === 0) {\n  return [{ json: { error: 'Keine Gebäude in ' + config.gemeinde + ' via OSM gefunden.' } }];\n}\n\n// Nur Gebäude mit Zentroid-Koordinaten\nconst buildings = elements.filter(e => e.center);\n\nreturn buildings.slice(0, 30).map(e => {\n  const lat  = e.center.lat;\n  const lng  = e.center.lon;\n  const tags = e.tags || {};\n\n  // Adresse aus OSM-Tags\n  const street = tags['addr:street']  || '';\n  const nr     = tags['addr:housenumber'] || '';\n  const address = [street, nr].filter(Boolean).join(' ') || `OSM-ID ${e.id}`;\n\n  // Baujahr (falls in OSM erfasst)\n  const baujahr = parseInt(tags['start_date'] || tags['year_of_construction'] || '0') || null;\n\n  // Bounding Box für Swisstopo Luftbild (±300m)\n  const dLat = 0.0027;\n  const dLng = 0.0040;\n  const bbox = `${lng-dLng},${lat-dLat},${lng+dLng},${lat+dLat}`;\n\n  return { json: {\n    osm_id:   e.id,\n    address,\n    baujahr,\n    lat,\n    lng,\n    bbox,\n    building_type: tags.building || '—',\n    gemeinde: config.gemeinde,\n    chat_id:  config.chat_id,\n    min_sqm:  config.min_sqm,\n    max_sqm:  config.max_sqm\n  }};\n});"
      },
      "id": "n4-parse-buildings",
      "name": "Gebäude Parsen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 340]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Overpass-Query für MFH im 200m-Umkreis aufbauen\nconst lat = $json.lat;\nconst lng = $json.lng;\nconst query = `[out:json][timeout:30];\n(\n  way[\"building:levels\"~\"^[3-9]\"](around:200,${lat},${lng});\n  relation[\"building:levels\"~\"^[3-9]\"](around:200,${lat},${lng});\n  way[\"building\"=\"apartments\"](around:200,${lat},${lng});\n);\nout count;`;\nreturn [{ json: { ...$json, mfh_query: query } }];"
      },
      "id": "n4b-build-mfh-query",
      "name": "MFH-Query aufbauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 340]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://overpass-api.de/api/interpreter",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "data", "value": "={{ $json.mfh_query }}" }
          ]
        },
        "options": {}
      },
      "id": "n5-overpass-mfh",
      "name": "Overpass MFH-Prüfung",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 340]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// MFH-Anteil berechnen\nconst elements = $json.elements || [];\nconst mfh_count = parseInt(elements[0]?.tags?.total || 0);\nconst mfh_ratio = Math.min(mfh_count / 8, 1);\nconst mfh_ratio_pct = Math.round(mfh_ratio * 100);\nconst qualifies_mfh = mfh_ratio >= 0.6;\nreturn [{ json: { ...$input.item.json, mfh_count, mfh_ratio_pct, qualifies_mfh } }];"
      },
      "id": "n6-calc-mfh",
      "name": "MFH-Anteil berechnen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1620, 340]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-mfh",
              "leftValue": "={{ $json.qualifies_mfh }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "n7-if-mfh",
      "name": "MFH ≥ 60%?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1840, 340]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://wms.geo.admin.ch/?SERVICE=WMS&REQUEST=GetMap&VERSION=1.1.1&LAYERS=ch.swisstopo.swissimage&STYLES=default&FORMAT=image%2Fjpeg&SRS=EPSG%3A4326&BBOX={{ $json.bbox }}&WIDTH=900&HEIGHT=900",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "n8-aerial",
      "name": "Swisstopo Luftbild laden",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2060, 200]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Telegram-Rapport formatieren\nconst item = $input.item.json;\nconst baujahr_text = item.baujahr ? item.baujahr : 'unbekannt (OSM)';\nconst mfh_icon = item.qualifies_mfh ? '✅' : '⚠️';\n\nconst report = [\n  '🏠 *PARZELLEN-ANALYSE – KANTON BERN*',\n  '━━━━━━━━━━━━━━━━━━━━━━━',\n  '',\n  `📍 *${item.address}*`,\n  `Gemeinde: ${item.gemeinde}`,\n  `Koordinaten: \\`${item.lat}, ${item.lng}\\``,\n  `OSM-ID: ${item.osm_id}`,\n  '',\n  '*🏗 GEBÄUDE*',\n  `• Typ: ${item.building_type}`,\n  `• Baujahr: ${baujahr_text}`,\n  '',\n  '*🏙 UMGEBUNG*',\n  `• MFH-Gebäude (200m): ${item.mfh_count}  ${mfh_icon}`,\n  `• MFH-Anteil: ${item.mfh_ratio_pct}%`,\n  '',\n  '*📈 ENTWICKLUNGSPOTENZIAL*',\n  '🟢 *Qualifiziert – Off-Market Ansatz empfohlen*',\n  '',\n  '*🔑 EIGENTÜMER-ABFRAGE*',\n  '[Grundbuch Kanton Bern](https://www.grundbuch.apps.be.ch)',\n  '[Parzelle auf map.geo.admin.ch](https://map.geo.admin.ch/?lang=de)',\n  '',\n  '_→ Direkt Eigentümer kontaktieren (Off-Market)_'\n].join('\\n');\n\nreturn [{ json: { ...item, telegram_report: report } }];"
      },
      "id": "n9-format-report",
      "name": "Rapport formatieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2280, 200]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendPhoto",
        "chatId": "={{ $json.chat_id }}",
        "binaryData": true,
        "binaryProperty": "data",
        "additionalFields": {
          "caption": "=📍 *{{ $json.address }}* – {{ $json.gemeinde }}\nSwisstopo Luftbild | MFH-Anteil: {{ $json.mfh_ratio_pct }}%",
          "parse_mode": "Markdown"
        }
      },
      "id": "n10-tg-photo",
      "name": "Telegram – Luftbild",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2500, 200],
      "credentials": { "telegramApi": { "id": "", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendLocation",
        "chatId": "={{ $json.chat_id }}",
        "latitude":  "={{ $json.lat }}",
        "longitude": "={{ $json.lng }}"
      },
      "id": "n11-tg-location",
      "name": "Telegram – GPS-Pin",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2720, 200],
      "credentials": { "telegramApi": { "id": "", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.telegram_report }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "n12-tg-report",
      "name": "Telegram – Rapport",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2940, 200],
      "credentials": { "telegramApi": { "id": "", "name": "Telegram Bot" } }
    },
    {
      "parameters": {},
      "id": "n13-noop",
      "name": "Nicht qualifiziert",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2060, 480]
    }
  ],
