# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Immobiliensuche – Kanton Bern
RE_MIN_PLOT_SQM=900
RE_MAX_PLOT_SQM=2000
# Komma-getrennte Gemeinden (leer = ganzer Kanton Bern)
RE_MUNICIPALITIES=Köniz,Ostermundigen,Muri bei Bern,Zollikofen

# Telegram Bot (Rapport + Luftbilder)
# 1. @BotFather auf Telegram kontaktieren → /newbot → Token kopieren
# 2. Bot starten → /start senden
# 3. Chat-ID abrufen: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Higgsfield Content-Generierung
HIGGSFIELD_API_KEY=

# Instagram Meta Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
